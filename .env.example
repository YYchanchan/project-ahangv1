# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# uni-app API base URL.
# Leave empty for local H5 development (Vite proxies /api to port 3000).
# For WeChat Mini Program, configure an HTTPS domain that has been added to
# the Mini Program request-domain allowlist.
VITE_API_BASE_URL="https://api.example.com"
# Optional Mini Program override. If empty, VITE_API_BASE_URL is used.
VITE_MP_API_BASE_URL="https://api.example.com"

# Local development listeners and Vite proxy target.
# 0.0.0.0 means listen on all local network interfaces; use 127.0.0.1
# when the service should only be reachable from this computer.
VITE_DEV_HOST="0.0.0.0"
VITE_DEV_PORT="5173"
VITE_ADMIN_DEV_HOST="0.0.0.0"
VITE_ADMIN_DEV_PORT="5174"
VITE_API_PROXY_TARGET="http://127.0.0.1:3000"

# Node API listener.
HOST="0.0.0.0"
PORT="3000"
# Persistent directory for original uploaded image files.
UPLOAD_DIR="./uploads"

# Backend JSON-line logs. One app-YYYY-MM-DD.log file is written per day.
# Previous-week and older files are deleted automatically every Monday.
LOG_DIR="./logs"
LOG_TIMEZONE="Asia/Shanghai"

# Database. Node always uses MySQL; there is no in-memory fallback.
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="project_ahang"
MYSQL_PASSWORD="project_ahang_dev"
MYSQL_DATABASE="project_ahang"
# DATABASE_URL="mysql://project_ahang:password@127.0.0.1:3306/project_ahang"

# Separate admin website credentials. Change both values before deployment.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
ADMIN_DISPLAY_NAME="阿杭管理员"

# WeChat Mini Program login credentials (server-side only).
WECHAT_MINI_APPID=""
WECHAT_MINI_SECRET=""

# Optional WeChat Open Platform App login credentials.
WECHAT_APP_APPID=""
WECHAT_APP_SECRET=""

# Long random value used to sign the app's own session token.
WECHAT_SESSION_SECRET=""

# Optional H5 cross-origin API access. Prefer a same-origin reverse proxy in production.
CORS_ORIGIN=""
