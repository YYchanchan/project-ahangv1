{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "types": [
      "@dcloudio/types",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "admin/**/*.ts",
    "admin/**/*.vue",
    "server.ts",
    "server/**/*.ts",
    "scripts/**/*.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "src/**/*.tsx",
    "src/context/**"
  ]
}
